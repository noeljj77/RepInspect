# Copy to backend/.env and adjust. Never commit the real .env file.

APP_ENV=development
LOG_LEVEL=INFO

# Matches the defaults in docker-compose.yml
DATABASE_URL=postgresql+psycopg://repinspect:repinspect@localhost:5433/repinspect

# Comma-separated list of origins allowed to call the API directly.
# In development the Vite dev server proxies /api, so this is only a fallback.
CORS_ORIGINS=http://localhost:5173

# Key used to sign login tokens. Must be at least 32 characters.
# The value below is for local development only and is rejected when
# APP_ENV=production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-do-not-use-in-production-0000

# How long a login lasts, in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- GitHub ----------------------------------------------------------------
# Optional. Without a token GitHub allows 60 API requests per hour (shared by
# everyone on your network), and each analysis uses 4. A token with NO scopes
# (a fine-grained token with only public read access) raises that to 5000.
# Create one at https://github.com/settings/tokens and keep it out of git.
# GITHUB_TOKEN=

# --- Import limits (defaults shown) ----------------------------------------
# MAX_DOWNLOAD_BYTES=52428800        # compressed download from GitHub (50 MB)
# MAX_UPLOAD_BYTES=52428800          # uploaded ZIP file (50 MB)
# MAX_ARCHIVE_SCAN_BYTES=524288000   # uncompressed data read through (500 MB)
# MAX_FILES=5000                     # files kept per analysis
# MAX_FILE_BYTES=1048576             # larger single files are skipped (1 MB)
# MAX_TOTAL_BYTES=104857600          # total size of kept files (100 MB)
# MAX_ACTIVE_ANALYSES_PER_USER=3

# Where imported source snapshots are stored (default: backend/data/artifacts).
# ARTIFACT_DIR=

# --- AI explanations ---------------------------------------------------------
# Optional. Without a key the app works as before and the AI buttons explain
# that AI is not set up. Get a free Gemini key at https://aistudio.google.com/apikey
# and keep it out of git. Set LLM_PROVIDER=none to switch AI off entirely.
# GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite

# Limits (defaults shown). The free tier has small daily quotas, so each user
# gets an allowance; ask for less context if you hit token limits.
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_ATTEMPTS=3
# AI_CONTEXT_CHARS=60000
# MAX_AI_REQUESTS_PER_USER_PER_DAY=40
# MAX_ACTIVE_AI_JOBS_PER_USER=2

# --- Chat (search index and answers) -------------------------------------------
# The embedding model runs locally on the CPU and is downloaded once (about 130 MB)
# into MODEL_CACHE_DIR (default: backend/data/models). Defaults shown.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MAX_TOKENS=256
# MAX_CHUNKS_PER_ANALYSIS=20000
# RAG_TOP_K=8                    # excerpts per answer
# RAG_CONTEXT_CHARS=24000        # total excerpt text per answer
# CHAT_HISTORY_TURNS=3           # earlier questions and answers sent as context
